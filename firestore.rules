rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email == get(/databases/$(database)/documents/access/admin).data.email;
    }
    function legacyOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email == get(/databases/$(database)/documents/migration/owner).data.email;
    }
    match /users/{uid} {
      allow read, write: if owns(uid);
      match /{document=**} { allow read, write: if owns(uid); }
    }
    match /defaults/{document} {
      allow read: if signedIn() && document in ['foods', 'foodLists'];
      allow write: if admin() && document in ['foods', 'foodLists'];
    }
    match /publicFoods/{document=**} { allow read, write: if admin(); }
    match /access/admin { allow get: if admin(); }
    match /migration/legacy { allow get: if legacyOwner(); }
    match /migration/legacy/{document=**} { allow read: if legacyOwner(); }
    // All other paths, including old shared writes, are denied by default.
  }
}
